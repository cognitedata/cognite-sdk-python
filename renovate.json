{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>cognitedata/renovate-config-public",
    ":automergeMinor"
  ],
  "packageRules": [
    {
      "enabled": false,
      "matchManagers": ["pep621"]
    },
    {
      "enabled": false,
      "matchPackageNames": ["mcr.microsoft.com/devcontainers/python", "cognite/toolkit"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "labels": [
    "dependencies",
    "auto-merge"
  ]
}
